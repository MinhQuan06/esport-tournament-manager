<%@ Page Title="Đăng ký giải đấu" Language="C#" MasterPageFile="~/Site.Master"
    AutoEventWireup="true" CodeFile="JoinTournament.aspx.cs" Inherits="Manager_JoinTournament" %>
<asp:Content ContentPlaceHolderID="MainContent" runat="server">
<div class="page-header">
    <h1 class="page-title">Đăng ký đội tham gia giải đấu</h1>
</div>

<asp:Label ID="lblMsg" runat="server" Visible="false" />

<div class="es-card">
    <div class="es-alert info" style="font-size:12px;margin-bottom:18px;">
        <i class="bi bi-info-circle"></i>
        Chọn giải đấu trước → hệ thống sẽ liệt kê các đội của bạn cùng game để chọn nhanh.
        Hoặc tạo đội mới ngay nếu chưa có.
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            <label class="form-label">Giải đấu * (chỉ hiện giải "Chưa bắt đầu")</label>
            <asp:DropDownList ID="ddlTour" runat="server" CssClass="form-select"
                AutoPostBack="true" OnSelectedIndexChanged="ddlTour_Changed"
                DataValueField="TournamentID" DataTextField="DisplayName" />
        </div>
    </div>

    <asp:Panel ID="pnlTeamPicker" runat="server" Visible="false">
        <div class="mb-3">
            <label class="form-label">Đội của tôi (cùng game <strong style="color:var(--accent-cyan);"><asp:Literal ID="litGame" runat="server" /></strong>)</label>
            <asp:DropDownList ID="ddlExisting" runat="server" CssClass="form-select"
                AutoPostBack="true" OnSelectedIndexChanged="ddlExisting_Changed"
                DataValueField="TeamID" DataTextField="DisplayName" AppendDataBoundItems="true">
                <asp:ListItem Value="" Text="-- Tạo đội mới --" />
            </asp:DropDownList>
            <small style="color:var(--text-muted);">Chọn đội đã có sẽ tự điền thông tin bên dưới (bạn vẫn có thể chỉnh sửa).</small>
        </div>

        <hr style="border-color:var(--border);" />
        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">Tên đội *</label>
                <asp:TextBox ID="txtName" runat="server" CssClass="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Tên ngắn</label>
                <asp:TextBox ID="txtShort" runat="server" CssClass="form-control" placeholder="T1, GAM..." MaxLength="10" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Quản lý đội (tên)</label>
                <asp:TextBox ID="txtManager" runat="server" CssClass="form-control" placeholder="VD: Trần Hữu Long" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Màu logo</label>
                <asp:DropDownList ID="ddlColor" runat="server" CssClass="form-select">
                    <asp:ListItem Value="#3b82f6" Text="Xanh dương" />
                    <asp:ListItem Value="#ef4444" Text="Đỏ" />
                    <asp:ListItem Value="#10b981" Text="Xanh lá" />
                    <asp:ListItem Value="#f59e0b" Text="Cam" />
                    <asp:ListItem Value="#8b5cf6" Text="Tím" />
                    <asp:ListItem Value="#06b6d4" Text="Cyan" />
                    <asp:ListItem Value="#ec4899" Text="Hồng" />
                </asp:DropDownList>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Mô tả đội</label>
            <asp:TextBox ID="txtDesc" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="2" />
        </div>
        <asp:Button ID="btnRegister" runat="server" Text="Đăng ký tham gia"
            CssClass="btn btn-primary" OnClick="btnRegister_Click" />
    </asp:Panel>

    <asp:Panel ID="pnlNoTour" runat="server" Visible="false">
        <div style="text-align:center;color:var(--text-muted);padding:30px;">
            <i class="bi bi-flag" style="font-size:36px;"></i>
            <p style="margin-top:10px;">Vui lòng chọn giải đấu để bắt đầu đăng ký.</p>
        </div>
    </asp:Panel>
</div>
</asp:Content>
