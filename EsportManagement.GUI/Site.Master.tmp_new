<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Esport Pro</asp:ContentPlaceHolder> - Esport Pro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="<%# ResolveUrl("~/Content/Site.css") %>" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body runat="server" id="bodyTag">
<form id="form1" runat="server">

<asp:Panel ID="phSidebar" runat="server" Visible="false" CssClass="sidebar">
    <div class="sidebar-brand">
        <h1 class="brand-text">ESPORT <span class="brand-accent">PRO</span></h1>
        <div class="brand-sub">TOURNAMENT MANAGEMENT SYSTEM</div>
    </div>

    <div class="sidebar-section">
        <div class="section-title">TỔNG QUAN</div>
        <asp:HyperLink ID="lnkDashboard" runat="server" CssClass="menu-item">
            <i class="bi bi-grid-1x2-fill"></i> Dashboard
        </asp:HyperLink>
    </div>

    <div class="sidebar-section">
        <div class="section-title">QUẢN LÝ</div>
        <asp:HyperLink ID="lnkTournaments" runat="server" CssClass="menu-item">
            <i class="bi bi-trophy-fill"></i> Giải đấu
        </asp:HyperLink>
        <asp:HyperLink ID="lnkTeams" runat="server" CssClass="menu-item">
            <i class="bi bi-shield-fill"></i> Đội thi đấu
        </asp:HyperLink>
        <asp:HyperLink ID="lnkPlayers" runat="server" CssClass="menu-item" Visible="false">
            <i class="bi bi-person-fill"></i> Người chơi
        </asp:HyperLink>
        <asp:HyperLink ID="lnkSchedule" runat="server" CssClass="menu-item">
            <i class="bi bi-calendar-event-fill"></i> Lịch thi đấu
        </asp:HyperLink>
        <asp:HyperLink ID="lnkMatches" runat="server" CssClass="menu-item" Visible="false">
            <i class="bi bi-lightning-charge-fill"></i> Trận đấu
        </asp:HyperLink>
    </div>

    <div class="sidebar-section">
        <div class="section-title">KẾT QUẢ</div>
        <asp:HyperLink ID="lnkRanking" runat="server" CssClass="menu-item">
            <i class="bi bi-trophy"></i> Kết quả &amp; XH
        </asp:HyperLink>
        <asp:HyperLink ID="lnkStatistics" runat="server" CssClass="menu-item">
            <i class="bi bi-graph-up"></i> Thống kê
        </asp:HyperLink>
    </div>

    <asp:Panel ID="phAdminMenu" runat="server" Visible="false">
        <div class="sidebar-section">
            <div class="section-title">HỆ THỐNG</div>
            <asp:HyperLink ID="lnkAccounts" runat="server" CssClass="menu-item">
                <i class="bi bi-people-fill"></i> Tài khoản
            </asp:HyperLink>
            <asp:HyperLink ID="lnkRoles" runat="server" CssClass="menu-item">
                <i class="bi bi-key-fill"></i> Vai trò
            </asp:HyperLink>
        </div>
    </asp:Panel>

    <div class="sidebar-user">
        <div class="user-avatar"><asp:Literal ID="litInitials" runat="server" /></div>
        <div class="user-info">
            <div class="user-name"><asp:Literal ID="litUserName" runat="server" /></div>
            <div class="user-role"><asp:Literal ID="litUserRole" runat="server" /></div>
        </div>
        <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-logout"
            OnClick="btnLogout_Click" ToolTip="Đăng xuất">
            <i class="bi bi-box-arrow-right"></i>
        </asp:LinkButton>
    </div>
</asp:Panel>

<main class="main-content">
    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
</main>
</form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
